# Plantilla de variables de entorno (NO contiene secretos reales).
# Copia este archivo a .env y completa los valores SOLO en local.
# En la nube, carga estas variables en el panel de Render.

# Perfil de Spring Boot para produccion (Supabase/PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# Supabase -> Connect -> Session Pooler (puerto 5432)
# Formato: jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# El usuario del pooler incluye el project ref: postgres.<PROJECT_REF>
SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
SPRING_DATASOURCE_PASSWORD=REEMPLAZAR_CON_PASSWORD_DE_SUPABASE

# Genera uno con: openssl rand -base64 48
JWT_SECRET=REEMPLAZAR_CON_SECRETO_DE_AL_MENOS_32_CARACTERES

# Dominio del frontend en Vercel (sin barra final)
FRONTEND_URL=https://TU-APP.vercel.app

# Permite previews de Vercel (https://*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# Tamano maximo del pool de conexiones a Supabase
DB_POOL_MAX=5
